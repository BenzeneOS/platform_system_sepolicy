batterystats_service
bluetooth_manager_service
clipboard_service
companion_device_service
connectivity_service
consumer_ir_service
content_service
content_capture_service
content_suggestions_service
country_detector_service
device_identifiers_service
deviceidle_service
devicelock_service
display_service
dreams_service
dropbox_service
font_service
graphicsstats_service
hardware_properties_service
input_method_service
input_service
ipsec_service
jobscheduler_service
launcherapps_service
light_service
locale_service
location_service
media_communication_service
media_projection_service
media_router_service
media_session_service
midi_service
mount_service
netpolicy_service
netstats_service
network_management_service
notification_service
package_service
package_native_service
permission_service
permissionmgr_service
power_service
print_service
procstats_service
search_service
sensorservice_service
sensor_privacy_service
settings_service
statusbar_service
storagestats_service
surfaceflinger_service
telecom_service
registry_service
tethering_service
textclassification_service
textservices_service
texttospeech_service
timedetector_service
thermal_service
tv_input_service
uimode_service
uri_grants_service
usagestats_service
user_service
vcn_management_service
vibrator_service
vibrator_manager_service
voiceinteraction_service
webviewupdate_service
rttmanager_service
content_restriction_service
gpu_service
personal_context_service
protolog_configuration_service
supervision_service
activity_task_service
assetatlas_service
IProxyService_service
connectivity_native_service
connmetrics_service
credential_service
platform_compat_service
game_service
grammatical_inflection_service
hint_service
imms_service
legacy_permission_service
media_metrics_service
media_quality_service
memtrackproxy_service
music_recognition_service
permission_checker_service
restrictions_service
security_state_service
selection_toolbar_service
servicediscovery_service
speech_recognition_service
translation_service
tv_ad_service
tv_iapp_service
virtual_device_native_service }:service_manager find;

# allow pcc components to use UDP sockets provided by the system server but not
# modify them other than to connect
allow pcc_component system_server:udp_socket {
        connect getattr read recvfrom sendto write getopt setopt };

allow pcc_component ashmem_device:chr_file { getattr read ioctl watch watch_reads append write lock map };

###
### neverallow rules
###
#
# TODO: b/442762197 - Add a neverallow rule for servicemanager services

neverallow pcc_component app_data_file_type:file execute_no_trans;

# Receive or send uevent messages.
neverallow pcc_component domain:netlink_kobject_uevent_socket *;

# Receive or send generic netlink messages
neverallow pcc_component domain:netlink_socket *;

# Too much leaky information in debugfs. It's a security
# best practice to ensure these files aren't readable.
neverallow pcc_component debugfs_type:file read;

# execute gpu_device
neverallow pcc_component gpu_device:chr_file execute;

# access files in /sys with the default sysfs label
neverallow pcc_component sysfs:file *;

# Avoid reads from generically labeled /proc files
# Create a more specific label if needed
neverallow pcc_component proc:file { no_rw_file_perms no_x_file_perms };

# Avoid mutating external storage
neverallow pcc_component { sdcard_type fuse media_rw_data_file }:file create;
neverallow pcc_component { sdcard_type fuse media_rw_data_file }:dir {write add_name remove_name lock};

# Avoid reads to proc_net, it contains too much device wide information about
# ongoing connections.
neverallow pcc_component proc_net:file no_rw_file_perms;

