###
### NowPlaying, a platform-signed ambient music recognizer.
###

type nowplaying_app, domain;
typeattribute nowplaying_app coredomain;

app_domain(nowplaying_app)
net_domain(nowplaying_app)

allow nowplaying_app app_api_service:service_manager find;
allow nowplaying_app audioserver_service:service_manager find;
allow nowplaying_app mediametrics_service:service_manager find;

userdebug_or_eng(`permissive nowplaying_app;')
